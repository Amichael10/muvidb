{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 0 * * *"
    }
  ],
  "images": {
    "sizes": [
      16,
      32,
      48,
      160,
      256,
      384,
      640,
      750,
      828,
      1080,
      1280,
      1920
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 86400
  },
  "functions": {
    "api/ssr.ts": {
      "includeFiles": "build/server/**",
      "maxDuration": 60
    },
    "api/seo.ts": {
      "maxDuration": 60
    },
    "api/data.ts": {
      "maxDuration": 60
    },
    "api/automation.ts": {
      "maxDuration": 60
    },
    "api/telegram.ts": {
      "maxDuration": 60
    },
    "api/social.ts": {
      "includeFiles": "{api/_lib/{fonts,decor,social-html-templates}/**,src/features/social-studio/**}",
      "maxDuration": 60
    },
    "api/cron/sync.ts": {
      "maxDuration": 60
    },
    "api/ai.ts": {
      "maxDuration": 60
    },
    "api/media.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:js|css|woff2|woff|ttf|eot))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|gif|webp|svg|ico|webmanifest))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/storage/v1/render/image/public/:path*",
      "destination": "https://pkenrmorywmuvnzfoylp.supabase.co/storage/v1/render/image/public/:path*"
    },
    {
      "source": "/storage/v1/object/public/:path*",
      "destination": "https://pkenrmorywmuvnzfoylp.supabase.co/storage/v1/object/public/:path*"
    },
    {
      "source": "/api/drive/create-upload-session",
      "destination": "/api/social?task=create_upload_session"
    },
    {
      "source": "/api/drive",
      "destination": "/api/social?task=create_upload_session"
    },
    {
      "source": "/api/telegram",
      "destination": "/api/data?_r=telegram"
    },
    {
      "source": "/api/auth-email",
      "destination": "/api/automation?action=auth-email"
    },
    {
      "source": "/api/semantic-search",
      "destination": "/api/ai?op=semantic-search"
    },
    {
      "source": "/api/external",
      "destination": "/api/media?op=external"
    },
    {
      "source": "/api/film/:id",
      "destination": "/api/data?_r=films&id=:id"
    },
    {
      "source": "/api/channel/:id",
      "destination": "/api/data?_r=channels&id=:id"
    },
    {
      "source": "/api/admin/search-channels",
      "destination": "/api/data?_r=channels&action=yt_search"
    },
    {
      "source": "/api/films",
      "destination": "/api/data?_r=films"
    },
    {
      "source": "/api/people",
      "destination": "/api/data?_r=people"
    },
    {
      "source": "/api/channels",
      "destination": "/api/data?_r=channels"
    },
    {
      "source": "/api/content",
      "destination": "/api/data?_r=content"
    },
    {
      "source": "/api/job-apply",
      "destination": "/api/data?_r=job-apply"
    },
    {
      "source": "/api/send-welcome-email",
      "destination": "/api/data?_r=welcome-email"
    },
    {
      "source": "/api/actor-claims",
      "destination": "/api/data?_r=actor-claims"
    },
    {
      "source": "/api/social",
      "destination": "/api/data?_r=social"
    },
    {
      "source": "/api/fetch-youtube",
      "destination": "/api/data?_r=fetch-youtube"
    },
    {
      "source": "/api/youtube",
      "destination": "/api/external?provider=youtube"
    },
    {
      "source": "/api/tmdb",
      "destination": "/api/external?provider=tmdb"
    },
    {
      "source": "/api/health",
      "destination": "/api/media?op=health"
    },
    {
      "source": "/api/mirror-images",
      "destination": "/api/media?op=mirror"
    },
    {
      "source": "/api/scrape-imdb-actor",
      "destination": "/api/automation?action=scrape-imdb-actor"
    },
    {
      "source": "/api/deduplicator",
      "destination": "/api/automation?action=deduplicator"
    },
    {
      "source": "/api/people-enrichment",
      "destination": "/api/automation?action=people-enrichment"
    },
    {
      "source": "/api/cron/refresh-videos",
      "destination": "/api/cron/sync?task=refresh_videos"
    },
    {
      "source": "/api/social/tiktok/callback",
      "destination": "/api/social?task=tiktok_callback"
    },
    {
      "source": "/api/social/meta/callback",
      "destination": "/api/social?task=meta_callback"
    },
    {
      "source": "/api/social/threads/callback",
      "destination": "/api/social?task=threads_callback"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?type=sitemap&slug=index"
    },
    {
      "source": "/sitemap-static.xml",
      "destination": "/api/seo?type=sitemap&slug=static"
    },
    {
      "source": "/sitemap-people.xml",
      "destination": "/api/seo?type=sitemap&slug=people"
    },
    {
      "source": "/sitemap-films.xml",
      "destination": "/api/seo?type=sitemap&slug=films"
    },
    {
      "source": "/sitemap-watch.xml",
      "destination": "/api/seo?type=sitemap&slug=watch"
    },
    {
      "source": "/sitemap-companies.xml",
      "destination": "/api/seo?type=sitemap&slug=companies"
    },
    {
      "source": "/sitemap-cinemas.xml",
      "destination": "/api/seo?type=sitemap&slug=cinemas"
    },
    {
      "source": "/sitemap-channels.xml",
      "destination": "/api/seo?type=sitemap&slug=channels"
    },
    {
      "source": "/sitemap-critics.xml",
      "destination": "/api/seo?type=sitemap&slug=critics"
    },
    {
      "source": "/sitemap-plays.xml",
      "destination": "/api/seo?type=sitemap&slug=plays"
    },
    {
      "source": "/sitemap-careers.xml",
      "destination": "/api/seo?type=sitemap&slug=careers"
    },
    {
      "source": "/sitemap-:slug.xml",
      "destination": "/api/seo?type=sitemap&slug=:slug"
    },
    {
      "source": "/((?!api/|assets/|favicon|site\\.webmanifest|apple-touch-icon|images/|robots\\.txt|sitemap|.*\\.(?:ico|png|svg|jpg|jpeg|webp|js|css|woff2|woff|ttf|txt|xml|json)).*)",
      "destination": "/api/ssr?__pathname=/$1"
    }
  ]
}
