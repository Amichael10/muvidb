VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here
VITE_TMDB_API_KEY=your_tmdb_api_key_here
TMDB_ACCESS_TOKEN=your_tmdb_access_token_here

# Social Studio Phase 1 (mock-only foundation)
SOCIAL_STUDIO_ENABLED=false
SOCIAL_PUBLISH_MODE=mock
SOCIAL_DEFAULT_TIMEZONE=Africa/Lagos
SOCIAL_ASSET_BUCKET=social-published-assets

# Cloudinary — background removal for Social Studio actor cut-outs.
# Each key/secret pair belongs to ONE cloud, so a cloud name is mandatory.
#
#   Separate accounts (this is what actually multiplies the add-on quota):
#     set CLOUDINARY_CLOUD_NAME_1..n next to each key pair.
#   One account with several key pairs:
#     set a single CLOUDINARY_CLOUD_NAME; it applies to every pair. Note the
#     background-removal quota is metered per ACCOUNT, so rotating within one
#     cloud does not raise the ceiling.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME_1=
CLOUDINARY_API_KEY_1=
CLOUDINARY_API_SECRET_1=
CLOUDINARY_CLOUD_NAME_2=
CLOUDINARY_API_KEY_2=
CLOUDINARY_API_SECRET_2=
CLOUDINARY_CLOUD_NAME_3=
CLOUDINARY_API_KEY_3=
CLOUDINARY_API_SECRET_3=

# Server-only Gemini keys (never expose via VITE_). Rotation picks up
# GEMINI_API_KEY, GEMINI_API_KEY_2 … _10 (and comma-separated lists).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_PEOPLE_MODEL=gemini-2.5-flash
GEMINI_PEOPLE_DAILY_BUDGET_USD=5

# YouTube Data API — server rotation uses YOUTUBE_API_KEY + _2…_10
# (VITE_YOUTUBE_API_KEY is a fallback only).
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=
YOUTUBE_API_KEY_4=

# Groq (llama fallback — not Grok/xAI). Optional numbered keys also rotate.
GROQ_API_KEY=

# Cohere (Command chat fallback + Embed / Rerank). Optional _2…_10 also rotate.
# Live search uses Rerank over lexical hits (no pgvector IO).
# Offline: npm run embed:films → film_embeddings → npm run related:build
# Opt-in pgvector search only when compute allows (Small+): SEMANTIC_VECTOR_SEARCH=true
COHERE_API_KEY=
# COHERE_CHAT_MODEL=command-a-03-2025
# COHERE_EMBED_MODEL=embed-v4.0
# COHERE_RERANK_MODEL=rerank-v4.0-pro
# SEMANTIC_VECTOR_SEARCH=false

# Competitor Scraper Targets (Codenamed Feeds)
FEED_DELTA_URL="https://filmflux.app/movies"
FEED_DELTA_BASE_URL="https://filmflux.app"

FEED_GAMMA_URL="https://irokotv.com/category/video"
FEED_GAMMA_BASE_URL="https://irokotv.com"
FEED_GAMMA_CHANNEL_HANDLE="@irokotv"
FEED_GAMMA_CHANNEL_NAME="IrokoTV"

FEED_ZETA_URL="https://web.docuth.com/home"

FEED_KAPPA_SITEMAP_URL="https://kava.tv/sitemap.xml"
FEED_KAPPA_BASE_URL="https://kava.tv"

FEED_THETA_BASE_URL="https://www.partyjolloftv.com"

FIRECRAWL_API_KEY_2=your_firecrawl_api_key_here
FIRECRAWL_API_KEY_3=your_firecrawl_api_key_here
FIRECRAWL_API_KEY_4=your_firecrawl_api_key_here

# Telegram ops bot (scrape alerts, signup alerts, /block /unblock)
# 1) Message @BotFather → /newbot → copy token
# 2) Message your bot once, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates → copy chat.id
# 3) After deploy: npx tsx scripts/set_telegram_webhook.ts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional but recommended — same value on Vercel Production
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_URL=https://muvidb.com/api/telegram
# Hits per IP per 5 min before alert (default 50)
SCRAPE_ALERT_THRESHOLD=50
# Optional: ms between alerts for the same IP (default 30m)
# SCRAPE_ALERT_COOLDOWN_MS=1800000
# Optional comma-separated trusted IPs (home/office). Prefer Telegram /allow.
# SCRAPE_IP_ALLOWLIST=1.2.3.4,5.6.7.8

CLOUDINARY_API_KEY_1=your_api_key_here
CLOUDINARY_CLOUD_NAME_1=Your_cloud_name_here
CLOUDINARY_API_SECRET_1=your_api_secret_here
CLOUDINARY_API_KEY_2=your_api_key_here
CLOUDINARY_CLOUD_NAME_2=your_cloud_name_here
CLOUDINARY_API_SECRET_2=your_api_secret_here
CLOUDINARY_API_KEY_3=your_api_key_here
CLOUDINARY_CLOUD_NAME_3=your_cloud_name_here
CLOUDINARY_API_SECRET_3=your_api_secret_here

# Days a rendered social asset is kept after the post reaches a terminal
# state. The platform holds the canonical copy once published.
SOCIAL_ASSET_RETENTION_DAYS=30

# Set to "true" to route Supabase-hosted images through the paid image
# transformation endpoint. Off by default: Pro includes only 100 source images
# per cycle and our posters are already ~43 KB.
VITE_SUPABASE_IMAGE_TRANSFORMS=false

# Resend — welcome email (server-only; must also be set in Vercel Production)
RESEND_API_KEY=re_xxxxxxxx
# Optional overrides (defaults: MuviDB Welcome <support@muvidb.com>)
RESEND_FROM_EMAIL=MuviDB Welcome <support@muvidb.com>
RESEND_REPLY_TO=support@muvidb.com
