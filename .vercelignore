# Vercel turns every file under api/ into a Serverless Function, so a vitest
# file there gets deployed and counts against the Hobby 12-function cap.
# api/media.test.ts was live at /api/media.test returning 500. Tests under
# api/_lib/ are unaffected (underscore dirs aren't routed) but are excluded
# too, so vitest deps never ship.
api/**/*.test.ts
api/**/*.test.tsx

# Ignore local test and temp folders
temp_lumi_*
temp_lumi/
output/
scratch/
scripts/
!scripts/write_spa_index.mjs
!scripts/build_email_templates.mjs
.git/
node_modules/
dist/

# Ignore big media assets at root level only (NOT inside public/)
/*.mp4
/*.png
/*.jpg
/*.jpeg
/*.gif

# Ignore root-level scripts only (with leading slash)
/*.js
/*.cjs
/*.sql
/*.py
/*.txt
/*.json
!package.json
!tsconfig.json
!vercel.json
